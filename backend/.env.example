# Environment
NODE_ENV=development
PORT=5000

# Database Connection (Replace with your local PostgreSQL credentials)
# Example: postgresql://<username>:<password>@localhost:5432/<database_name>?schema=public
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/octopus_maintenance?schema=public"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Model
AI_MODEL_PATH=./models
GEMINI_API_KEY=your_gemini_api_key_here

# Database Seed Credentials (for `npm run seed`)
SEED_DEFAULT_PASSWORD=your_seed_password_here
