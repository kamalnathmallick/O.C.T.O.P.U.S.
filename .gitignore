# Dependencies
node_modules/
**/node_modules/

# Build and cache output
.next/
**/.next/
dist/
**/dist/
coverage/
*.tsbuildinfo
.turbo/

# Environment variables & secrets (NEVER commit these)
.env
.env.*
*.env
**/.env
**/.env.*
**/.env.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.local

# Allow example templates to be committed
!.env.example
!**/.env.example
!backend/.env.example

# Certificates and keys
*.pem
*.key
*.cert
*.pfx

# Sensitive local credentials
TEST_CREDENTIALS.md

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
